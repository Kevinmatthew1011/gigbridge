# GigBridge Local Server Environment Configuration (Example)
# Copy this file to .env.server for local AI explanation development.
# Do NOT commit .env.server to source control.

# Explanation Provider: 'gemini' (primary live provider), 'groq' (optional), or 'mock' (offline)
EXPLAIN_PROVIDER=gemini

# Groq API Configuration (Supported low-latency model for JSON message selection)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini API Configuration (server-side only, never exposed to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Gemini Thinking Level: 'minimal' (default for fast structured selection), 'low', 'medium', 'high'
GEMINI_THINKING_LEVEL=minimal

# Optional Server Settings
PORT=3001
HOST=127.0.0.1
GEMINI_TIMEOUT_MS=30000
